# Root .gitignore for SayHii (Spring Boot Backend + Next.js Frontend)

# ===== Operating System Files =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===== IDE & Editors =====
.idea/
*.iws
*.iml
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
.springBeans
.sts4-cache
.apt_generated

# ===== Environment & Secrets =====
.env
.env*.local
*.env
application-local.properties
application-local.yml

# ===== Java & Maven (Backend) =====
**/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Logs
*.log
logs/
**/logs/

# ===== Node.js & Next.js (Frontend) =====
**/node_modules/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js build output
**/.next/
.next/
out/
**/out/
dist/
**/dist/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Next.js telemetry
.next/telemetry/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

sayhii